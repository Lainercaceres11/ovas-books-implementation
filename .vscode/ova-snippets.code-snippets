  "Panel with Game Millions": {
    "scope": "typescriptreact,typescript",
    "prefix": "ova-game-millions",
    "body": [
      "import { useState } from 'react';",
      "import { Audio, Col, Row } from 'books-ui';",
      "",
      "import { ${1:dataMilion} } from '${2:@/data/data-file}';",
      "import { ModalFeedback } from '@/shared/core/components';",
      "import GameMilions from '@/shared/core/components/game-millions/game-millions';",
      "import { Panel } from '@/shared/ui/components';",
      "",
      "const ${3:ComponentName} = () => {",
      "",
      "  const [currentQuestionIndex, setCurrentQuestionIndex] = useState(1);",
      "  const [isFinished, setIsFinished] = useState(false);",
      "  const [modal, setModal] = useState<'success' | 'wrong' | null>(null);",
      "",
      "  const handleResult = (result: boolean) => {",
      "    setModal(result ? 'success' : 'wrong');",
      "  };",
      "",
      "  const handleQuestionChange = (index: number) => {",
      "    setCurrentQuestionIndex(index);",
      "  };",
      "",
      "  return (",
      "    <>",
      "",
      "      <Panel>",
      "",
      "        <Panel.Section",
      "          interpreter={{",
      "            a11yURL: 'vid_int_des_${4:ova-name}_sld-${5:page}.mp4',",
      "            contentURL: `vid_int_${4:ova-name}_sld-${5:page}_P${'${currentQuestionIndex}'}.mp4`",
      "          }}>",
      "",
      "          <Audio a11y src=\"assets/audios/aud_des_${4:ova-name}_sld-${5:page}.mp3\" />",
      "",
      "          <Row justifyContent=\"center\" alignItems=\"center\">",
      "",
      "            <Col xs=\"11\" mm=\"10\" md=\"9\" lg=\"8\" hd=\"7\" addClass=\"u-flow\">",
      "",
      "              <Audio",
      "                key={`question-audio-${'${isFinished ? \"final\" : currentQuestionIndex}'}`}",
      "                src={",
      "                  isFinished",
      "                    ? 'assets/audios/aud_${4:ova-name}_sld-${5:page}_finish.mp3'",
      "                    : `assets/audios/aud_${4:ova-name}_sld-${5:page}_P${'${currentQuestionIndex}'}.mp3`",
      "                }",
      "              />",
      "",
      "              <p className=\"u-text-center\">",
      "                <span className=\"u-font-semibold\">",
      "                  ${6:Texto introductorio de la actividad.}",
      "                </span>",
      "              </p>",
      "",
      "              <GameMilions",
      "                alt={",
      "                  <p>",
      "                    <strong>${7:Animación 1.}</strong> ${8:Actividad interactiva.}",
      "                  </p>",
      "                }",
      "                data={${1:dataMilion}}",
      "                onResult={(result) => handleResult(result)}",
      "                onQuestionChange={handleQuestionChange}",
      "                onFinish={() => setIsFinished(true)}",
      "              />",
      "",
      "            </Col>",
      "",
      "          </Row>",
      "",
      "        </Panel.Section>",
      "",
      "      </Panel>",
      "",
      "      <ModalFeedback",
      "        finalFocusRef=\"main\"",
      "        isOpen={modal === 'success'}",
      "        onClose={() => setModal(null)}",
      "        type=\"success\"",
      "        audio=\"${9:assets/audios/correct.mp3}\">",
      "        <p>${10:Retroalimentación correcta.}</p>",
      "      </ModalFeedback>",
      "",
      "      <ModalFeedback",
      "        finalFocusRef=\"main\"",
      "        isOpen={modal === 'wrong'}",
      "        onClose={() => setModal(null)}",
      "        type=\"wrong\"",
      "        audio=\"${11:assets/audios/incorrect.mp3}\">",
      "        <p>${12:Retroalimentación incorrecta.}</p>",
      "      </ModalFeedback>",
      "",
      "    </>",
      "  );",
      "};",
      "",
      "export default ${3:ComponentName};",
      "$0"
    ],
    "description": "Section con el juego GameMillion con Audio, Interprete y modales"
  }
