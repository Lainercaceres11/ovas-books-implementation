  "Drag and drop activity": {
    "scope": "typescriptreact",
    "prefix": "ova-drag-activity",
    "body": [
      "import { useState, useRef } from 'react';",
      "import { Audio, Col, DragAndDrop, Row } from 'books-ui';",
      "import { DndActivity } from '@/shared/components/activities/dnd-activity';",
      "import { Content } from '@/shared/components/layouts';",
      "import { Button, Image } from '@/shared/components/ui';",
      "import { ModalFeedback } from '@/shared/components/features/modal-feedback';",
      "import type { Announcements } from '@dnd-kit/core';",
      "",
      "const MODALS = {",
      "  TRUE: 'modal-correct-activity',",
      "  FALSE: 'modal-wrong-activity'",
      "};",
      "",
      "const ${1:ComponentName} = () => {",
      "  const [isOpen, setIsOpen] = useState<string | null>(null);",
      "  const refTextWrapper = useRef<HTMLDivElement>(null);",
      "",
      "  const handleValidate = ({ result }: { result: boolean }) => {",
      "    const activityResult = result.toString().toUpperCase();",
      "    setIsOpen(MODALS[activityResult as keyof typeof MODALS]);",
      "  };",
      "",
      "  const closeModal = () => setIsOpen(null);",
      "",
      "  const announcements: Announcements = {",
      "    onDragStart({ active }) {",
      "      return `Se ha seleccionado la opción ${active.data.current?.label}.`;",
      "    },",
      "",
      "    onDragOver({ active, over }) {",
      "      if (over) {",
      "        return `la opción ${active.data.current?.label} se movió sobre la ${over.data.current?.label} opción desplegable.`;",
      "      }",
      "      return `la opción ${active.data.current?.label} ya no está sobre una opción desplegable.`;",
      "    },",
      "",
      "    onDragEnd({ active, over }) {",
      "      const paragraph = currentParagraph({",
      "        id: over?.id as string,",
      "        label: active.data.current?.label,",
      "        container: refTextWrapper.current",
      "      }) ?? '';",
      "",
      "      if (over) {",
      "        return `la opción \\${active.data.current?.label} se soltó sobre la \\${over.data.current?.label} opción desplegable. El texto generado es el siguiente: \\${paragraph}`;",
      "      }",
      "",
      "      return `la opción \\${active.data.current?.label} se eliminó.`;",
      "    },",
      "",
      "    onDragCancel({ active }) {",
      "      return `Se canceló la selección de la opción ${active.data.current?.label}.`;",
      "    }",
      "  };",
      "",
      "  return (",
      "    <>",
      "      <Content",
      "        interpreter={{",
      "          a11yURL: 'vid_int_des_${2:ova-name}_sld-${3:page}.mp4',",
      "          contentURL: 'vid_int_${2:ova-name}_sld-${3:page}.mp4'",
      "        }}",
      "      >",
      "",
      "        <Audio a11y src=\"assets/audios/aud_des_${2:ova-name}_sld-${3:page}.mp3\" />",
      "",
      "        <Row justifyContent=\"center\" alignItems=\"center\">",
      "",
      "          <Col xs=\"11\" mm=\"10\" md=\"9\" lg=\"6\" hd=\"5\" addClass=\"u-flow\">",
      "",
      "            <Audio addClass=\"u-m-0\" src=\"assets/audios/aud_${2:ova-name}_sld-${3:page}.mp3\" />",
      "",
      "            <div ref={refTextWrapper}>",
      "",
      "              <p className=\"u-text-justify\">",
      "                ${4:Enunciado general de la actividad.}",
      "              </p>",
      "",
      "              <DndActivity",
      "                id=\"ova-${2:ova-name}-dnd\"",
      "                minCorrectDrags={${5:3}}",
      "                onResult={handleValidate}",
      "                announcements={() => announcements}",
      "              >",
      "",
      "                <DragAndDrop.Container id=\"general-1\" label=\"Conjunto de opciones\">",
      "                  <DragAndDrop.Drag id=\"01\" label=\"opción uno\">${6:Opción 1}</DragAndDrop.Drag>",
      "                  <DragAndDrop.Drag id=\"02\" label=\"opción dos\">${7:Opción 2}</DragAndDrop.Drag>",
      "                  <DragAndDrop.Drag id=\"03\" label=\"opción tres\">${8:Opción 3}</DragAndDrop.Drag>",
      "                </DragAndDrop.Container>",
      "",
      "                <DragAndDrop.Drop id=\"drop-1\" validate={['01']} label=\"primera\" />",
      "                <DragAndDrop.Drop id=\"drop-2\" validate={['02']} label=\"segunda\" />",
      "                <DragAndDrop.Drop id=\"drop-3\" validate={['03']} label=\"tercera\" />",
      "",
      "                <Row justifyContent=\"center\" alignItems=\"center\">",
      "                  <DndActivity.Button>",
      "                    <Button label=\"Comprobar\" />",
      "                  </DndActivity.Button>",
      "",
      "                  <DndActivity.Button type=\"reset\">",
      "                    <Button label=\"Reiniciar\" addClass=\"js-modal-wrong\" />",
      "                  </DndActivity.Button>",
      "                </Row>",
      "",
      "              </DndActivity>",
      "            </div>",
      "",
      "          </Col>",
      "",
      "          <Col xs=\"11\" mm=\"10\" md=\"9\" lg=\"5\" hd=\"4\">",
      "            <Image",
      "              src=\"assets/images/${9:imagen.webp}\"",
      "              size=\"${10:20rem}\"",
      "              title=\"${11:Figura 1}\"",
      "              alt=\"${12:Descripción accesible de la imagen}\"",
      "            />",
      "          </Col>",
      "",
      "        </Row>",
      "",
      "      </Content>",
      "",
      "      <ModalFeedback",
      "        type=\"success\"",
      "        isOpen={isOpen === MODALS.TRUE}",
      "        onClose={closeModal}",
      "        audio={`assets/audios/aud_${2:ova-name}_sld-${3:page}_modal_correcto.mp3`}",
      "        finalFocusRef=\"#main\"",
      "        interpreter={{",
      "          contentURL: `vid_int_${2:ova-name}_sld-${3:page}_modal_correcto.mp4`",
      "        }}",
      "      >",
      "        <p>${13:¡Felicitaciones! Respuesta correcta.}</p>",
      "      </ModalFeedback>",
      "",
      "      <ModalFeedback",
      "        type=\"wrong\"",
      "        isOpen={isOpen === MODALS.FALSE}",
      "        onClose={closeModal}",
      "        audio={`assets/audios/aud_${2:ova-name}_sld-${3:page}_modal_incorrecto.mp3`}",
      "        finalFocusRef=\"#main\"",
      "        interpreter={{",
      "          contentURL: `vid_int_${2:ova-name}_sld-${3:page}_modal_incorrecto.mp4`",
      "        }}",
      "      >",
      "        <p>${14:Intenta nuevamente.}</p>",
      "      </ModalFeedback>",
      "",
      "    </>",
      "  );",
      "};",
      "",
      "interface CurrentParagraphProps {",
      "  id: string;",
      "  label?: string;",
      "  container: HTMLDivElement | null;",
      "}",
      "",
      "const currentParagraph = ({ id, label, container }: CurrentParagraphProps): string | undefined => {",
      "  if (!container) return;",
      "",
      "  const elements = container.querySelectorAll(",
      "    'p, div[data-type-component=\"droppable\"]'",
      "  ) as NodeListOf<HTMLElement>;",
      "",
      "  let paragraph = '';",
      "  const EMPTY = ' espacio en blanco ';",
      "",
      "  elements.forEach((element) => {",
      "    if (element.dataset.typeComponent !== 'droppable') {",
      "      paragraph += element.textContent ?? EMPTY;",
      "      return;",
      "    }",
      "",
      "    paragraph += element.id === id",
      "      ? ` ${label ?? EMPTY} `",
      "      : `${element.textContent || EMPTY}`;",
      "  });",
      "",
      "  return paragraph.trim();",
      "};",
      "export default ${1:ComponentName};"
    ],
    "description": "OVA Drag & Drop Activity completa con imports, lógica, accesibilidad y modales dinámicos"
  },
